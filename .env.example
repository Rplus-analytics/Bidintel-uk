# ---------------------------------------------------------------------------
# BidIntel — frontend environment (AWS)
# ---------------------------------------------------------------------------
#
# Copy to .env.local and fill in. .env.local is gitignored.
#
# Every value here is NON-SECRET and ships to the browser: Vite inlines anything
# prefixed VITE_ into the bundle, so it is readable by anyone who loads the app.
# A Cognito user pool ID and app client ID are public identifiers by design —
# they identify where to authenticate, they do not authorise anything. NEVER put
# an API key, a database password or an AWS access key in this file.

# --- Cognito -----------------------------------------------------------------
VITE_COGNITO_USER_POOL_ID=eu-north-1_9LKk8RR6t
VITE_COGNITO_CLIENT_ID=4ua1vhje9gmm3kekuk6spvf1r
VITE_COGNITO_REGION=eu-north-1

# --- PostgREST (the .from() backend) -----------------------------------------
#
# HTTP, not HTTPS. Cognito ID tokens cross this link in cleartext, so it is for
# local testing from an allowlisted IP only and must be replaced with HTTPS
# before cutover. The ALB security group admits a single /32; if the app
# suddenly returns nothing, the IP has probably changed — run
# scripts/allow-my-ip.sh and update admin_cidrs in
# aws-backend/infra/phase6-postgrest.
VITE_POSTGREST_URL=http://bidintel-postgrest-1007768748.eu-north-1.elb.amazonaws.com

# --- API Gateway (the functions.invoke() backend) ----------------------------
VITE_API_BASE_URL=https://tye76qu0y9.execute-api.eu-north-1.amazonaws.com

# --- Legacy Lovable/Supabase --------------------------------------------------
# Unused on this branch. Left documented so it is obvious they are dead rather
# than missing: the committed .env still carries them for the main branch, which
# Vercel deploys against Lovable Cloud.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_PROJECT_ID=
